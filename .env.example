NODE_ENV=development
PORT=3000
DB_PATH=./database/demo.sqlite
# DATABASE_PATH también se acepta por compatibilidad con la documentación inicial.
SESSION_SECRET=change-this-demo-secret
# Origen público de Angular para QR y enlaces verificables. APP_BASE_URL se acepta como alias heredado.
PUBLIC_APP_URL=http://localhost:4200
DEMO_MODE=true
CORS_ORIGIN=http://localhost:4200
